{
  "name": "dsh-custom-splash",
  "version": "0.1.0",
  "description": "DSH 自定义开屏动画：先播一段画面和声音，播完淡出露出界面。画面和声音是两个独立槽位，默认就带内置动画与内置音效；浏览器在首次交互前会拦截带声音的自动播放，插件会在第一次点击/按键后自动开启声音。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "splash",
    "splash-screen",
    "boot-animation",
    "startup-animation",
    "sound",
    "audio",
    "video",
    "mp4",
    "webm",
    "gif",
    "wav",
    "mp3"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "tools/pick-media-file.ps1",
    "README.md",
    "LICENSE"
  ],
  "//": "tools/ 里只有 pick-media-file.ps1 进包：宿主半在运行时按路径读取它来弹原生文件对话框，漏掉它会让文件选择静默降级成只能手输路径。generate-default-assets.py 与 verify 脚本是仓库自带的开发工具，使用者不需要。",
  "icon": "./icon.svg",
  "scripts": {
    "generate-assets": "python tools/generate-default-assets.py",
    "verify": "node tools/verify-contract.mjs && node tools/verify-client.mjs",
    "verify:contract": "node tools/verify-contract.mjs",
    "verify:client": "node tools/verify-client.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renxingdxx/dsh-plugins.git",
    "directory": "plugins/dsh-custom-splash"
  },
  "meta": {
    "title": "自定义开屏（带声音）",
    "description": "先播画面和声音，播完淡出露出界面。画面和声音独立配置，默认就带内置动画与音效。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  }
}
